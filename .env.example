# --- Postgres ---
DATABASE_URL=postgresql://diffchroma:diffchroma@localhost:5432/diffchroma

# --- RabbitMQ ---
AMQP_URL=amqp://diffchroma:diffchroma@localhost:5672

# --- S3 (MinIO locally; AWS S3 / Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs handed to clients outside the docker network.
# Defaults to S3_ENDPOINT when unset.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=diffchroma
S3_ACCESS_KEY=diffchroma
S3_SECRET_KEY=diffchroma123
S3_FORCE_PATH_STYLE=true

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
JWT_SECRET=dev-secret-change-me

# --- Seed (first run) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_CUSTOMER_NAME=Acme
SEED_PROJECT_NAME=web

# --- Render worker ---
RENDER_CONCURRENCY=4
VIEWPORTS=1280x720

# --- GitHub App (optional; check runs are skipped when unset) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# GitHub App install page linked from Manage (optional; the card degrades when
# unset). NEXT_PUBLIC_* values are inlined at build time — set it before
# building the dashboard image.
NEXT_PUBLIC_GITHUB_APP_URL=
